# ==============================================================================
# CodeCrypt Configuration Settings
# ==============================================================================

# Ollama HTTP Service Endpoint (default local daemon URL)
OLLAMA_URL=http://localhost:11434

# Configured open-weight AI model
# Recommended default: gemma2:2b (or gemma2:9b if your machine has sufficient VRAM)
OLLAMA_MODEL=gemma2:2b

# Request timeout in seconds for local AI inference
OLLAMA_TIMEOUT=120

# Maximum allowed code length in characters (default 15,000)
MAX_CODE_LENGTH=15000

# Server Host and Port
HOST=127.0.0.1
PORT=5000
DEBUG=false

# Optional repository link in footer (leave empty until published)
GITHUB_REPO_URL=
